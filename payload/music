#!/usr/bin/python3
"""Control MPD and select the UI for the desktop used at launch time."""
import os
from pathlib import Path
import socket
import subprocess as sp
import sys
import time

ROOT = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config'))) / 'ncmpcpp'
sys.path.insert(0, str(ROOT))
from desktop_support import detect


def mpd(command):
    with socket.create_connection(('127.0.0.1', 6600), timeout=4) as sock:
        stream = sock.makefile('rwb', buffering=0)
        if not stream.readline().startswith(b'OK MPD'):
            raise RuntimeError('6600 端口上的服务不是 MPD。')
        stream.write((command + '\n').encode())
        lines = []
        while True:
            line = stream.readline().decode().strip()
            if line == 'OK': return lines
            if not line or line.startswith('ACK'): raise RuntimeError(line or 'MPD disconnected')
            lines.append(line)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'show'
    if action not in ('show', 'ui-toggle', 'toggle', 'prev', 'next', 'hide', 'stop'):
        raise SystemExit('用法：music [show|ui-toggle|toggle|prev|next|hide|stop]')
    _, session, backend = detect()
    if backend == 'xfce-x11':
        os.execv('/usr/bin/python3', ['python3', str(ROOT/'music-x11.py'), *sys.argv[1:]])
    if action in ('hide', 'stop'):
        if action == 'stop': mpd('pause 1')
        sp.run(['/usr/bin/python3', str(ROOT/'portable-player.py'), 'hide'], check=True)
        return
    sp.run(['systemctl', '--user', 'start', 'mpd.service'], check=True)
    for attempt in range(30):
        try:
            status = mpd('status'); break
        except OSError:
            if attempt == 29: raise
            time.sleep(.1)
    if action in ('toggle', 'prev', 'next'):
        mpd(('pause 1' if 'state: play' in status else 'play') if action == 'toggle' else
            'previous' if action == 'prev' else 'next')
        return
    if session not in ('x11', 'wayland'):
        raise RuntimeError('请在图形桌面会话内打开播放器。')
    mpd('update')
    for _ in range(100):
        if not any(x.startswith('updating_db:') for x in mpd('status')): break
        time.sleep(.1)
    sp.run(['/usr/bin/python3', str(ROOT/'sync-library.py'), '--once'], check=True)
    if action != 'ui-toggle' and any(x.startswith('file: ') for x in mpd('playlistinfo')): mpd('play')
    log = Path.home()/'.local/state/manjaro-music-kit/player.log'
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open('a') as stream:
        process = sp.Popen(['/usr/bin/python3', str(ROOT/'portable-player.py'), action],
                           stdout=stream, stderr=stream, start_new_session=True)
        try:
            code = process.wait(timeout=.8)
            if code: raise RuntimeError(f'播放器启动失败，请查看 {log}')
        except sp.TimeoutExpired:
            pass
    print('已请求打开桌面音乐；日志：', log)


if __name__ == '__main__':
    try: main()
    except (OSError, RuntimeError, sp.CalledProcessError) as error:
        raise SystemExit('音乐启动失败：' + str(error))
